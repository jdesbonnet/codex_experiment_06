{
  "name": "tiny-vm",
  "displayName": "tiny_vm",
  "description": "tiny_vm bytecode language support + simulator-driven debugger (VS Code Web)",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "publisher": "tiny-vm-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "web"
  ],
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:tiny-vm-c",
    "onLanguage:tiny-vm-asm",
    "onCommand:tinyVm.openOpcodeTable",
    "onCommand:tinyVm.seedOpfs",
    "onCommand:tinyVm.openOpfsRoot",
    "onCommand:tinyVm.runBytecode",
    "onCommand:tinyVm.debugBytecode",
    "onFileSystem:tinyvm-opfs",
    "onDebug"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tiny-vm-c",
        "aliases": [
          "tiny_vm C",
          "tiny-vm-c",
          "cvm-c"
        ],
        "extensions": [
          ".cvm.c"
        ],
        "configuration": "./language-configurations/tiny-vm-c.json"
      },
      {
        "id": "tiny-vm-asm",
        "aliases": [
          "tiny_vm Asm",
          "tiny-vm-asm"
        ],
        "extensions": [
          ".vm"
        ],
        "configuration": "./language-configurations/tiny-vm-asm.json"
      }
    ],
    "grammars": [
      {
        "language": "tiny-vm-c",
        "scopeName": "source.tiny-vm-c",
        "path": "./syntaxes/tiny-vm-c.tmLanguage.json"
      },
      {
        "language": "tiny-vm-asm",
        "scopeName": "source.tiny-vm-asm",
        "path": "./syntaxes/tiny-vm-asm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tinyVm.openOpcodeTable",
        "title": "tiny_vm: Open Opcode Table",
        "category": "tiny_vm"
      },
      {
        "command": "tinyVm.seedOpfs",
        "title": "tiny_vm: Seed OPFS Workspace",
        "category": "tiny_vm"
      },
      {
        "command": "tinyVm.openOpfsRoot",
        "title": "tiny_vm: Open OPFS Workspace",
        "category": "tiny_vm"
      },
      {
        "command": "tinyVm.runBytecode",
        "title": "tiny_vm: Run Bytecode in Simulator",
        "category": "tiny_vm"
      },
      {
        "command": "tinyVm.debugBytecode",
        "title": "tiny_vm: Debug Bytecode in Simulator",
        "category": "tiny_vm"
      }
    ],
    "breakpoints": [
      {
        "language": "tiny-vm-c"
      },
      {
        "language": "tiny-vm-asm"
      }
    ],
    "configuration": {
      "title": "tiny_vm",
      "properties": {
        "tinyVm.apiUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Base URL of the tiny_vm backend API (compile + future simulate/auth endpoints). In dev this is the sidecar started by tools/dev_env_web/scripts/serve.sh; in production it's the cloud-hosted service."
        }
      }
    },
    "debuggers": [
      {
        "type": "tiny-vm",
        "label": "tiny_vm Simulator",
        "languages": [
          "tiny-vm-c",
          "tiny-vm-asm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "URI of the .bin bytecode file. The companion .bin.map (from `vm_cc.py --map`) is loaded automatically if present.",
                "default": "${workspaceFolder}/count10.bin"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first bytecode instruction (PC=0) instead of running immediately.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tiny-vm",
            "request": "launch",
            "name": "tiny_vm: debug current .bin",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.4.5"
  }
}
